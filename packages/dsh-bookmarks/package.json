{
  "name": "@local/dsh-bookmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "全平台收藏夹中枢：X / YouTube / Reddit / Bilibili / 知乎 / 小红书 的收藏、稍后再看、Saved 统一到一处",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web"
    }
  }
}
